@article{dominyPorphyromonasGingivalisAlzheimers2019,
  title = {{\emph{Porphyromonas Gingivalis}} in {{Alzheimer}}'s Disease Brains: {{Evidence}} for Disease Causation and Treatment with Small-Molecule Inhibitors},
  shorttitle = {{\emph{Porphyromonas Gingivalis}} in {{Alzheimer}}'s Disease Brains},
  author = {Dominy, Stephen S. and Lynch, Casey and Ermini, Florian and Benedyk, Malgorzata and Marczyk, Agata and Konradi, Andrei and Nguyen, Mai and Haditsch, Ursula and Raha, Debasish and Griffin, Christina and Holsinger, Leslie J. and {Arastu-Kapur}, Shirin and Kaba, Samer and Lee, Alexander and Ryder, Mark I. and Potempa, Barbara and Mydel, Piotr and Hellvard, Annelie and Adamowicz, Karina and Hasturk, Hatice and Walker, Glenn D. and Reynolds, Eric C. and Faull, Richard L. M. and Curtis, Maurice A. and Dragunow, Mike and Potempa, Jan},
  year = 2019,
  month = jan,
  journal = {Science Advances},
  volume = {5},
  number = {1},
  pages = {eaau3333},
  issn = {2375-2548},
  doi = {10.1126/sciadv.aau3333},
  urldate = {2026-01-28},
  abstract = {Gingipains from               Porphyromonas gingivalis               drive Alzheimer's pathology and can be blocked with small-molecule inhibitors.                        ,                             Porphyromonas gingivalis               , the keystone pathogen in chronic periodontitis, was identified in the brain of Alzheimer's disease patients. Toxic proteases from the bacterium called gingipains were also identified in the brain of Alzheimer's patients, and levels correlated with tau and ubiquitin pathology. Oral               P. gingivalis               infection in mice resulted in brain colonization and increased production of A{$\beta$}               1--42               , a component of amyloid plaques. Further, gingipains were neurotoxic in vivo and in vitro, exerting detrimental effects on tau, a protein needed for normal neuronal function. To block this neurotoxicity, we designed and synthesized small-molecule inhibitors targeting gingipains. Gingipain inhibition reduced the bacterial load of an established               P. gingivalis               brain infection, blocked A{$\beta$}               1--42               production, reduced neuroinflammation, and rescued neurons in the hippocampus. These data suggest that gingipain inhibitors could be valuable for treating               P. gingivalis               brain colonization and neurodegeneration in Alzheimer's disease.},
  langid = {english},
  file = {/Users/okamini1/Zotero/storage/K2JNLI9B/Dominy et al. - 2019 - Porphyromonas gingivalis in Alzheimer’s disease brains Evidence for disease causation and tr.pdf}
}

