@article{amendolaraEffectivenessOsteopathicCraniosacral2024,
  title = {Effectiveness of Osteopathic Craniosacral Techniques: A Meta-Analysis},
  author = {Amendolara, Alfred and Sheppert, Alexander and Powers, Ryan and Payne, Andrew and Stacey, Stephen and Sant, David},
  year = 2024,
  month = oct,
  journal = {Frontiers in Medicine},
  volume = {11},
  issn = {2296-858X},
  doi = {10.3389/fmed.2024.1452465},
  abstract = {{$<$}jats:sec{$><$}jats:title{$>$}Background{$<$}/jats:title{$><$}jats:p{$>$}Craniosacral osteopathic manipulative medicine---also known as craniosacral therapy (CST)---is a widely taught and used component of osteopathic medicine. This paper seeks to systematically review and conduct a meta-analysis of randomized controlled trials assessing the clinical effectiveness of CST compared to standard care, sham treatment, or no treatment in adults and children.{$<$}/jats:p{$><$}/jats:sec{$><$}jats:sec{$><$}jats:title{$>$}Methods{$<$}/jats:title{$><$}jats:p{$>$}A search of Embase, PubMed, and Scopus was conducted on 10/29/2023 and updated on 5/8/2024. There was no restriction placed on the date of publication. A Google Scholar search was conducted to capture grey literature. Backward citation searching was also implemented. All randomized controlled trials employing CST for any clinical outcome were included. Studies not available in English as well as studies that did not report adequate data were excluded. Multiple reviewers were used to assess for inclusions, disagreements were settled by consensus. PRISMA guidelines were followed in the reporting of this meta-analysis. Cochrane's Risk of Bias 2 tool was used to assess for risk of bias. All data were extracted by multiple independent observers. Effect sizes were calculated using a Hedge's G value (standardized mean difference) and aggregated using random effects models. The GRADE system was used to assess quality of evidence.{$<$}/jats:p{$><$}/jats:sec{$><$}jats:sec{$><$}jats:title{$>$}Results{$<$}/jats:title{$><$}jats:p{$>$}The primary study outcome was the effectiveness of CST for selected outcomes as applied to non-healthy adults or children and measured by standardized mean difference effect size. Twenty-four RCTs were included in the final meta-analysis with a total of 1,613 participants. When subgroup analyses were performed by primary outcome only, no significant effects were found. When secondary outcomes were included in subgroup analyses, results showed that only {$<$}jats:italic{$>$}Neonate health, structure{$<$}/jats:italic{$>$} ({$<$}jats:italic{$>$}g{$<$}/jats:italic{$>$}\,=\,0.66, {$<$}jats:italic{$>$}95\% CI{$<$}/jats:italic{$>$} [0.30; 1.02], {$<$}jats:italic{$>$}Prediction Interval{$<$}/jats:italic{$>$} [-0.73; 2.05]) and {$<$}jats:italic{$>$}Pain, chronic somatic{$<$}/jats:italic{$>$} ({$<$}jats:italic{$>$}g{$<$}/jats:italic{$>$}\,=\,0.34, {$<$}jats:italic{$>$}95\% CI{$<$}/jats:italic{$>$} [0.18; 0.50], {$<$}jats:italic{$>$}Prediction Interval{$<$}/jats:italic{$>$} [-0.41; 1.09]) show reliable, statistically significant effect. However, these should not be interpreted as positive results as wide prediction intervals, high bias, and statistical limitations temper the real-world implications of this finding.{$<$}/jats:p{$><$}/jats:sec{$><$}jats:sec{$><$}jats:title{$>$}Conclusions and relevance{$<$}/jats:title{$><$}jats:p{$>$}CST demonstrated no significant effects in this meta-analysis, indicating a lack of usefulness in patient care for any of the studied indications.{$<$}/jats:p{$><$}jats:p{$>$}Pre-registration available at {$<$}jats:ext-link{$>$}https://doi.org/10.17605/OSF.IO/54K6G{$<$}/jats:ext-link{$>$}.{$<$}/jats:p{$><$}/jats:sec{$><$}jats:sec{$><$}jats:title{$>$}Systematic Review Registration{$<$}/jats:title{$><$}jats:p{$><$}jats:ext-link{$>$}https://osf.io/54k6g{$<$}/jats:ext-link{$>$}.{$<$}/jats:p{$><$}/jats:sec{$>$}},
  keywords = {osteopathy,shock-protocol}
}

@article{andrisaniSleepApneaPathophysiology2023,
  title = {Sleep Apnea Pathophysiology},
  author = {Andrisani, Giovanni and Andrisani, Giorgia},
  year = 2023,
  month = mar,
  journal = {Sleep and Breathing},
  volume = {27},
  number = {6},
  pages = {2111--2122},
  doi = {10.1007/s11325-023-02783-7},
  urldate = {2026-01-12},
  abstract = {{$<$}jats:title{$>$}Abstract{$<$}/jats:title{$><$}jats:sec{$>$}                 {$<$}jats:title{$>$}Objective{$<$}/jats:title{$>$}                 {$<$}jats:p{$>$}The purpose of this study is to examine the pathophysiology underlying sleep apnea (SA).{$<$}/jats:p{$>$}               {$<$}/jats:sec{$><$}jats:sec{$>$}                 {$<$}jats:title{$>$}Background{$<$}/jats:title{$>$}                 {$<$}jats:p{$>$}We consider several critical features of SA including the roles played by the ascending reticular activating system (ARAS) that controls vegetative functions and electroencephalographic findings associated with both SA and normal sleep. We evaluate this knowledge together with our current understanding of the anatomy, histology, and physiology of the mesencephalic trigeminal nucleus (MTN) and mechanisms that contribute directly to normal and disordered sleep. MTN neurons express {$\gamma$}-aminobutyric acid (GABA) receptors which activate them (make chlorine come out of the cells) and that can be activated by GABA released from the hypothalamic preoptic area.{$<$}/jats:p{$>$}               {$<$}/jats:sec{$><$}jats:sec{$>$}                 {$<$}jats:title{$>$}Method{$<$}/jats:title{$>$}                 {$<$}jats:p{$>$}We reviewed the published literature focused on sleep apnea (SA) reported in Google Scholar, Scopus, and PubMed databases.{$<$}/jats:p{$>$}               {$<$}/jats:sec{$><$}jats:sec{$>$}                 {$<$}jats:title{$>$}Results{$<$}/jats:title{$>$}                 {$<$}jats:p{$>$}The MTN neurons respond to the hypothalamic GABA release by releasing glutamate that activates neurons in the ARAS. Based on these findings, we conclude that a dysfunctional MTN may be incapable of activating neurons in the ARAS, notably those in the parabrachial nucleus, and that this will ultimately lead to SA. Despite its name, obstructive sleep apnea (OSA) is not caused by an airway obstruction that prevents breathing.{$<$}/jats:p{$>$}               {$<$}/jats:sec{$><$}jats:sec{$>$}                 {$<$}jats:title{$>$}Conclusions{$<$}/jats:title{$>$}                 {$<$}jats:p{$>$}While obstruction may contribute to the overall pathology, the primary factor involved in this scenario is the lack of neurotransmitters.{$<$}/jats:p{$>$}               {$<$}/jats:sec{$>$}},
  keywords = {ALF-therapy,imported,sleep-apnea pathophysiology respiratory airway}
}

@article{asherAssociationToothLocation2024,
  title = {Association of Tooth Location, Occlusal Support and Chewing Ability with Cognitive Decline and Incident Dementia},
  author = {Asher, Sam and Suominen, Anna Liisa and Stephen, Ruth and Ngandu, Tiia and Koskinen, Seppo and Solomon, Alina},
  year = 2024,
  month = mar,
  journal = {Journal of Clinical Periodontology},
  volume = {52},
  number = {1},
  pages = {24--39},
  issn = {0303-6979},
  doi = {10.1111/jcpe.13970},
  abstract = {{$<$}jats:title{$>$}Abstract{$<$}/jats:title{$><$}jats:sec{$><$}jats:title{$>$}Aim{$<$}/jats:title{$><$}jats:p{$>$}Emerging evidence suggests association of tooth loss with impaired cognition. However, the differential effects of anterior versus posterior tooth loss, occlusal support loss and chewing ability are not considered comprehensively.{$<$}/jats:p{$><$}/jats:sec{$><$}jats:sec{$><$}jats:title{$>$}Materials and Methods{$<$}/jats:title{$><$}jats:p{$>$}We conducted cross-sectional ({$<$}jats:italic{$>$}N{$<$}/jats:italic{$>$}\,=\,4036) and longitudinal analyses ({$<$}jats:italic{$>$}N{$<$}/jats:italic{$>$}\,=\,2787) on data from Health 2000 and 2011 Surveys for associations of posterior occlusal support loss, anterior versus posterior tooth loss, and chewing ability with baseline cognition and 11-year cognitive decline. Additionally, 15-year incident dementia risk was investigated ({$<$}jats:italic{$>$}N{$<$}/jats:italic{$>$}\,=\,4073).{$<$}/jats:p{$><$}/jats:sec{$><$}jats:sec{$><$}jats:title{$>$}Results{$<$}/jats:title{$><$}jats:p{$>$}After considering relevant confounders and potential reverse causality bias, posterior occlusal support loss significantly increased dementia risk across all categories indicative of posterior occlusal support loss (hazard ratios [HRs] between 1.99 and 2.89). Bilateral inadequate posterior occlusal support was associated with 11-year decline in overall cognition (odds ratio [OR]\,=\,1.48:1.00--2.19), and unilateral inadequate posterior occlusal support with total immediate (OR\,=\,1.62:1.14--2.30) and delayed recall decline (OR\,=\,1.45:1.03--2.05). Moreover, posterior tooth loss was associated with dementia (HR\,=\,2.23:1.27--3.91) and chewing ability with total immediate decline (OR\,=\,1.80:1.04--3.13).{$<$}/jats:p{$><$}/jats:sec{$><$}jats:sec{$><$}jats:title{$>$}Conclusions{$<$}/jats:title{$><$}jats:p{$>$}Posterior tooth and occlusal support loss significantly increases dementia risk. The impact of posterior occlusal support loss appears to be dose-dependent, and this effect is distinct from that of dentures. Dental healthcare services should be particularly attentive to the state of posterior dentition. Further studies exploring possible mechanisms are warranted.{$<$}/jats:p{$><$}/jats:sec{$>$}}
}

